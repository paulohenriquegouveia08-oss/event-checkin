// Schema do sistema de credenciamento e controle de presença.
//
// Nota de arquitetura (ver docs/architecture.md): o MVP não implementa
// multi-tenancy via uma tabela Organization — o Event já funciona como
// fronteira de isolamento de dados (participantes, terminais e check-ins
// sempre pertencem a um evento). Adicionar Organization no futuro é uma
// migration aditiva (organizationId nullable em Event/User), sem quebrar
// o que existe hoje.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Quem enxerga o evento.
///
/// PRIVATE é o padrão de propósito: a migração não pode tornar público
/// um evento que já existe. Publicar é decisão de alguém, sempre.
/// Ciclo de vida de um trabalho submetido.
///
/// DRAFT existe porque o autor monta a submissão em etapas (dados, depois
/// coautores, depois o arquivo) e pode fechar o navegador no meio. Sem ele,
/// só haveria "existe" e "não existe", e uma submissão pela metade contaria
/// como enviada.
///
/// WITHDRAWN é do autor; REJECTED é da comissão. Guardar os dois separados
/// responde "por que este trabalho não está nos anais?" sem ambiguidade.
enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum EventStatus {
  ACTIVE
  CLOSED
}

enum ParticipantStatus {
  ACTIVE
  CANCELLED
}

enum TerminalStatus {
  PENDING // criado pelo admin, aguardando ativação
  ACTIVE
  INACTIVE
}

enum CheckInSource {
  ONLINE // registrado diretamente pelo terminal, backend disponível
  OFFLINE_SYNC // registrado offline no terminal, recebido depois via /terminals/sync
}

enum InscriptionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Ver src/modules/certificates/certificate-eligibility.service.ts —
// LOCKED e ELIGIBLE nunca têm fileKey; o PDF só é gerado (GENERATED) sob
// demanda, no primeiro download, depois de elegível.
enum CertificateStatus {
  LOCKED // evento ainda não terminou, ou presença não confirmada
  ELIGIBLE // elegível (evento terminou + presente), PDF ainda não gerado
  GENERATED // PDF já gerado e armazenado (fileKey preenchido)
  REVOKED // gerado e depois revogado pelo admin — download bloqueado
}

// RBAC 100% dirigido por dados: perfis e permissões são configuráveis
// pelo próprio ADMINISTRADOR via UI, não fixos em código. A única exceção
// é o próprio papel "ADMINISTRADOR" (Role.isSystem = true): não pode ser
// excluído nem ter permissões removidas, senão o sistema pode ficar sem
// ninguém capaz de gerenciar usuários/perfis — ver requirePermission() em
// src/middleware/auth.ts, que trata isSystem como "todas as permissões",
// ignorando a tabela RolePermission pra esse papel.
model Role {
  id          String   @id @default(uuid())
  key         String   @unique // slug estável, ex: "ADMINISTRADOR" — usado em código só pro bootstrap
  name        String // nome de exibição, editável
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// Catálogo de permissões — cada uma corresponde a um ponto real de
// checagem no código (ver src/shared/permissions.ts), então só é criada
// junto de uma migration quando uma funcionalidade nova precisa dela. O
// que É livre de deploy é decidir quais permissões cada Role tem
// (RolePermission), não quais permissões existem.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // ex: "users.create"
  description String
  category    String // agrupamento pra UI, ex: "Usuários", "Eventos"
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

// Registro de ações administrativas sensíveis (criar/editar/excluir
// usuário, trocar perfil, criar/editar perfil, mudar permissões). Não é
// um log genérico de tudo — só o que envolve controle de acesso, que é
// o que a especificação de auditoria deste RBAC pede.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String // preservado mesmo se o ator for excluído depois
  action     String // ex: "user.create", "role.update_permissions"
  entityType String // ex: "User", "Role"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(ACTIVE)

  // Inscrições (portal apps/pre-copol). registrationDeadline fecha as
  // inscrições automaticamente na data/hora configurada; registrationsClosedAt
  // é um fechamento manual (botão "Encerrar" no admin) independente da data —
  // se setado, inscrições ficam fechadas mesmo antes do prazo. "Retomar" só
  // limpa esse campo; se o prazo automático já passou, reabre mas o site já
  // volta a considerar fechado pela data (ver EventsService.isRegistrationOpen).
  registrationDeadline  DateTime?
  registrationsClosedAt DateTime?

  // Conteúdo do site pre-copol 100% editável pelo admin — formato livre,
  // ver src/modules/events/site-content.ts para o shape esperado
  // (heroSubtitle, aboutText, pricingTiers etc.) e os fallbacks quando null.
  /// Identificador curto para a URL pública (copol-2026 → /e/copol-2026).
  /// Opcional porque os eventos que já existem não têm; único porque vira endereço.
  slug       String?         @unique
  /// IANA. Tudo é gravado em UTC; isto define como a data aparece para
  /// o organizador e nos e-mails do evento.
  timezone   String          @default("America/Sao_Paulo")
  language   String          @default("pt-BR")
  visibility EventVisibility @default(PRIVATE)

  siteContent Json?

  // Configuração do certificado/comprovante deste evento — carga horária,
  // texto descritivo, signatários. Formato livre, mesmo princípio de
  // siteContent: ver src/modules/certificates/certificate-settings.ts para
  // o shape esperado e os fallbacks quando null. Nunca hardcoded no template.
  certificateSettings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants     Participant[]
  terminals        Terminal[]
  checkIns         CheckIn[]
  inscriptions     Inscription[]
  modules          EventModule[]
  submissionSettings SubmissionSettings?
  submissionModalities SubmissionModality[]
  submissionTopics     SubmissionTopic[]
  submissions          Submission[]
  certificates     Certificate[]
  attendanceProofs AttendanceProof[]

  @@map("events")
}

/// Módulos ligados neste evento.
///
/// Tabela, e não colunas booleanas nem um campo Json, por três motivos:
/// cada linha guarda QUEM ligou e QUANDO (o AuditLog registra a ação, mas
/// não o estado); módulo novo não exige migração, só uma linha; e a
/// consulta "quais eventos usam submissão" vira um WHERE em vez de varrer
/// JSON.
///
/// Ausência de linha significa DESLIGADO. Assim, aplicar esta migração não
/// muda o comportamento de nenhum evento existente — todos continuam
/// exatamente como estão até alguém ligar algo no painel.
///
/// O catálogo do que cada chave significa fica no código
/// (src/shared/event-modules.ts), não aqui: módulo sem tela seria uma
/// linha apontando para lugar nenhum.
model EventModule {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Chave do catálogo: inscription, submission, review, schedule,
  /// checkin, certificate.
  module String

  enabledAt DateTime @default(now())
  /// User.id de quem ligou. Null quando veio de um padrão do sistema —
  /// é o que separa "alguém decidiu" de "o sistema deu".
  enabledBy String?

  @@unique([eventId, module])
  @@index([eventId])
  @@map("event_modules")
}

/// Regras da chamada de trabalhos deste evento.
///
/// Tabela separada, e não colunas em Event, porque só existe para eventos
/// que abrem chamada — a maioria não abre. Em Event, seriam seis colunas
/// nulas em todo evento que é só palestra.
model SubmissionSettings {
  id      String @id @default(uuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Janela de envio. Null em qualquer um dos dois = aquele lado não
  /// limita. Fora da janela o sistema recusa envio novo, mas continua
  /// aceitando que o autor edite o que já mandou até a data de fechamento.
  opensAt  DateTime?
  closesAt DateTime?

  /// Se o autor paga taxa de submissão. Só registra a regra — não há
  /// cobrança implementada, e nada é bloqueado por falta de pagamento.
  authorFeeRequired Boolean  @default(false)
  authorFeeAmount   Decimal? @db.Decimal(10, 2)

  maxFileSizeMb Int @default(10)

  /// Quantos pareceres são necessários para decidir um trabalho.
  /// Usado pelo módulo de avaliação.
  minReviewsToDecide Int @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("submission_settings")
}

/// Formato do trabalho: pôster, comunicação oral, relato de caso.
/// Cadastrável pelo organizador porque cada congresso nomeia o seu.
model SubmissionModality {
  id          String  @id @default(uuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean @default(true)
  position    Int     @default(0)

  submissions Submission[]

  createdAt DateTime @default(now())

  @@unique([eventId, name])
  @@index([eventId])
  @@map("submission_modalities")
}

/// Área temática: Ortodontia, Periodontia, Saúde Coletiva.
/// É o que determina para qual parecerista o trabalho vai.
model SubmissionTopic {
  id       String  @id @default(uuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  active   Boolean @default(true)
  position Int     @default(0)

  submissions Submission[]

  createdAt DateTime @default(now())

  @@unique([eventId, name])
  @@index([eventId])
  @@map("submission_topics")
}

model Submission {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Protocolo curto que o autor usa para falar do trabalho ("COPOL-0042").
  /// Existe porque ninguém dita um uuid por telefone.
  code String @unique

  /// Restrict, não Cascade: apagar uma modalidade que tem trabalhos
  /// deixaria os trabalhos sem classificação, ou os apagaria junto. As
  /// duas coisas são piores do que o organizador receber um erro dizendo
  /// que precisa mover os trabalhos antes.
  modalityId String
  modality   SubmissionModality @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  topicId    String
  topic      SubmissionTopic    @relation(fields: [topicId], references: [id], onDelete: Restrict)

  title    String
  abstract String   @db.Text
  keywords String[]

  /// Chave no storage (mesma abstração dos certificados). Null enquanto o
  /// autor não anexou — a submissão pode existir em DRAFT sem arquivo.
  fileKey       String?
  fileName      String?
  fileSizeBytes Int?

  status SubmissionStatus @default(DRAFT)

  submittedAt DateTime?
  withdrawnAt DateTime?
  decidedAt   DateTime?

  /// Similaridade com os OUTROS trabalhos do mesmo evento, de 0 a 1.
  /// Calculada internamente (pg_trgm), sem serviço externo. Null = ainda
  /// não verificado. Não é detecção de plágio contra a web nem contra
  /// bases acadêmicas — isso depende de fornecedor contratado.
  similarityScore     Float?
  similarityCheckedAt DateTime?

  authors SubmissionAuthor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([modalityId])
  @@index([topicId])
  @@map("submissions")
}

/// Autores de um trabalho, em ordem.
///
/// Não referencia User nem Participant: coautor de artigo frequentemente
/// não tem conta no sistema e nunca vai ao evento. Guardar nome e e-mail
/// soltos é o que reflete a realidade de uma submissão acadêmica.
model SubmissionAuthor {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  name        String
  email       String
  institution String?

  /// Quem apresenta no evento. A comissão precisa saber para montar a
  /// grade, e é quem recebe o certificado de apresentação.
  isPresenter Boolean @default(false)
  position    Int     @default(0)

  @@index([submissionId])
  @@map("submission_authors")
}

model Participant {
  id       String            @id @default(uuid())
  eventId  String
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  email    String?
  phone    String?
  document String?
  status   ParticipantStatus @default(ACTIVE)

  // Token opaco de alta entropia que representa o participante no QR Code.
  // Nunca contém nome/CPF/e-mail/telefone. Pode ser revogado e regerado
  // (revokedAt marca o token antigo como inválido; um novo Participant.qrToken
  // é atribuído via rotação, mantendo o mesmo participantId).
  qrToken   String    @unique
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns         CheckIn[]
  certificates     Certificate[]
  attendanceProofs AttendanceProof[]

  @@index([eventId])
  @@map("participants")
}

model Terminal {
  id         String         @id @default(uuid())
  eventId    String
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  identifier String         @unique // ex.: TERM-001
  status     TerminalStatus @default(PENDING)

  // Fluxo de ativação (ver docs/security.md): o admin cria o terminal e
  // recebe um código de ativação de curta duração. O equipamento troca esse
  // código, uma única vez, por um token de longa duração (hash armazenado
  // aqui, o valor em claro só existe na resposta da ativação).
  activationCode          String?   @unique
  activationCodeExpiresAt DateTime?
  credentialHash          String?
  activatedAt             DateTime?
  lastSeenAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns CheckIn[]

  @@index([eventId])
  @@map("terminals")
}

model CheckIn {
  id            String        @id @default(uuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  terminalId    String?
  // SetNull: excluir um terminal não pode apagar o histórico de presenças
  // já registradas por ele — só desassocia (checkIn.terminalId vira null).
  terminal      Terminal?     @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  source        CheckInSource @default(ONLINE)

  // Id gerado no terminal enquanto offline; usado para deduplicar reenvios
  // do mesmo registro durante a sincronização (idempotência por terminal).
  localCheckInId String?

  checkedInAt DateTime
  createdAt   DateTime @default(now())

  // Garante, no nível do banco, que o mesmo participante não seja
  // credenciado duas vezes no mesmo evento — mesmo sob concorrência entre
  // terminais diferentes.
  @@unique([eventId, participantId])
  @@unique([terminalId, localCheckInId])
  @@index([terminalId])
  @@map("checkins")
}

// Tentativa de check-in que NÃO virou um CheckIn (duplicidade —
// participante já credenciado antes — ou rejeição — QR inválido/
// participante inativo). Sem isso, esses casos só existiam como evento ao
// vivo em memória (adminCheckInBus): se o admin não estivesse com o
// monitor aberto no exato momento, a tentativa desaparecia pra sempre,
// sem nenhum jeito de recuperar depois — diferente de um check-in
// confirmado, que sempre fica visível porque vira uma linha em
// "checkins". Esta tabela existe só pra dar essa mesma confiabilidade
// pros dois outros casos (ver getRecentCheckInsForMonitor em
// checkins.service.ts).
//
// Sem relações/FK de propósito (igual audit_logs) — é um log de eventos,
// não um registro que precisa de integridade referencial; participantId/
// terminalId podem não existir mais (ou nunca ter existido, no caso de QR
// inválido) sem que isso quebre nada aqui.
model CheckInAttempt {
  id            String              @id @default(uuid())
  eventId       String
  participantId String?
  participantName      String?
  participantEmail     String?
  participantPhone     String?
  participantDocument  String?
  terminalId    String?
  terminalName  String?
  status        CheckInAttemptStatus
  source        CheckInSource
  errorMessage  String?
  attemptedAt   DateTime            @default(now())

  @@index([eventId, attemptedAt])
  @@map("checkin_attempts")
}

enum CheckInAttemptStatus {
  ALREADY_CHECKED_IN
  REJECTED
}

model Inscription {
  id            String            @id @default(uuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String?
  name          String
  email         String
  document      String // CPF
  phone         String?
  institution   String?
  // Texto livre (não é mais enum fixo) — key de Event.siteContent.pricingTiers
  // vigente no momento da inscrição. Ver modules/inscriptions/inscriptions.service.ts.
  category      String            @db.VarChar(50)
  amount        Decimal           @db.Decimal(10, 2)
  status        InscriptionStatus @default(PENDING)
  paymentId     String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([eventId])
  @@map("inscriptions")
}

// Um certificado por (evento, participante) — regenerar não cria uma nova
// linha, apenas atualiza status/fileKey (ver certificates.repository.ts).
// verificationCode é o identificador exposto na URL pública de validação
// (QR Code impresso no PDF): opaco e não sequencial, nunca o id da linha.
model Certificate {
  id            String            @id @default(uuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  status        CertificateStatus @default(LOCKED)

  verificationCode String  @unique
  fileKey          String? // chave no storage (ver certificate-storage.ts); só preenchido quando status = GENERATED

  // Carga horária vigente no momento da última geração — acompanha o PDF
  // em cache (ver settingsSnapshotHash abaixo): se o admin muda a
  // configuração do certificado depois, o próximo download detecta e
  // regenera, e este campo é atualizado junto.
  workloadHours Int?

  // Hash (sha256) do que influencia o conteúdo do PDF no momento da
  // geração — nome/datas do evento + certificateSettings resolvido (ver
  // computeCertificateContentHash em certificates.service.ts). No
  // próximo download, se o hash atual não bater com este, o certificado
  // em cache está desatualizado e é regenerado automaticamente antes de
  // servir — sem exigir ação manual do admin nem "aviso de nova versão".
  settingsSnapshotHash String?

  // Liberação manual pelo admin. Preenchido, vale como critério de
  // elegibilidade por si só (ver isEligible em
  // certificate-eligibility.service.ts) — é o caminho para entregar o
  // certificado a quem o fluxo automático não cobre: faltou registrar o
  // check-in, a pessoa participou mas o terminal falhou, o evento ainda
  // não encerrou formalmente, etc. `manuallyReleasedBy` guarda o User.id
  // de quem liberou, para auditoria (nunca é exibido ao participante).
  manuallyReleasedAt DateTime?
  manuallyReleasedBy String?

  generatedAt DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, participantId])
  @@index([eventId])
  @@index([status])
  @@map("certificates")
}

// Comprovante de presença — independente do certificado (ver seção 8 do
// pedido), mesmo princípio de cache: gerado uma vez, reaproveitado depois.
model AttendanceProof {
  id            String @id @default(uuid())
  eventId       String
  event         Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  verificationCode String  @unique
  fileKey          String?

  generatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, participantId])
  @@index([eventId])
  @@map("attendance_proofs")
}
