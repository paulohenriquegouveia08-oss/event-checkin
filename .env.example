# Variáveis usadas pelo docker-compose.yml na VPS.
# Copie para ".env" (na raiz do projeto) e preencha com valores reais.
# Nunca commitar o .env com valores reais.

# --- PostgreSQL ---
POSTGRES_USER=event_checkin
POSTGRES_PASSWORD=troque-esta-senha-do-banco
POSTGRES_DB=event_checkin

# --- Backend ---
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_ADMIN_EXPIRES_IN=8h
PORT=3000

# --- Painel admin (web) ---
ADMIN_PORT=8080
# Endereço público pelo qual o NAVEGADOR do admin e o app do terminal vão
# acessar o backend — IP da VPS por enquanto (sem domínio/HTTPS ainda).
# Ex.: http://203.0.113.10:3000
PUBLIC_API_URL=http://troque-pelo-ip-da-vps:3000

# --- Seed do primeiro usuário administrador ---
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=troque-esta-senha

# --- Portal do participante (Vercel) ---
# URL do frontend do participante no Vercel (para CORS)
# Ex.: https://checkin.seudominio.com.br
ATTENDEE_URL=https://seu-app.vercel.app
CORS_ORIGINS=https://seu-app.vercel.app,http://localhost:3001

# --- Certificados/comprovantes ---
# Base pública do site pre-copol (Vercel), usada só para montar o link de
# validação embutido no QR Code do certificado. Sem barra no final.
CERTIFICATE_VALIDATION_BASE_URL=https://seu-precopol.vercel.app/certificados
