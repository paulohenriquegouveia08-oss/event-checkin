# Copie este arquivo para .env e preencha com valores reais.
# Nunca commitar o .env com valores reais.

NODE_ENV=development
PORT=3000

# String de conexão do PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/event_checkin_dev

# Segredo usado para assinar tokens JWT (admin e terminal).
# Gere um valor forte, ex.: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-forte

# Tempo de expiração do token de sessão do admin
JWT_ADMIN_EXPIRES_IN=8h

# Credenciais do primeiro usuário administrador, usadas apenas pelo script
# de seed (npm run seed). Não ficam salvas em texto puro no banco.
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=troque-esta-senha
